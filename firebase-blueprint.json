{
  "entities": {
    "Duty": {
      "title": "Duty",
      "description": "A collateral duty assignment for a soldier.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "jobTitle": { "type": "string" },
        "lastName": { "type": "string" },
        "rank": { "type": "string" },
        "dateStarted": { "type": "string" },
        "termLength": { "type": "string" },
        "termEndDate": { "type": "string" },
        "elementOrGroup": { "type": "string" },
        "tierLevel": { "type": "number" },
        "specialized": { "type": "boolean" },
        "dutyType": { "type": "string", "enum": ["EL", "U", "N/A"] },
        "isCommandAppointed": { "type": "boolean" },
        "isNonTiered": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["category", "jobTitle", "lastName", "rank", "elementOrGroup", "dutyType"]
    },
    "Admin": {
      "title": "Admin",
      "description": "User with administrative privileges.",
      "type": "object",
      "properties": {
        "email": { "type": "string" }
      },
      "required": ["email"]
    },
    "UpdateRequest": {
      "title": "UpdateRequest",
      "description": "A user-submitted request to update a broadening position's personnel details.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "dutyId": { "type": "string" },
        "category": { "type": "string" },
        "jobTitle": { "type": "string" },
        "currentLastName": { "type": "string" },
        "currentRank": { "type": "string" },
        "currentDateStarted": { "type": "string" },
        "requestedLastName": { "type": "string" },
        "requestedRank": { "type": "string" },
        "requestedDateStarted": { "type": "string" },
        "requestor": { "type": "string" },
        "requestedScopeOfResponsibilities": { "type": "string" },
        "isNewHire": { "type": "boolean" },
        "isCsmApproved": { "type": "boolean" },
        "justification": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "currentJobTitle": { "type": "string" },
        "requestedJobTitle": { "type": "string" },
        "currentTierLevel": { "type": "number" },
        "requestedTierLevel": { "type": "number" },
        "currentIsCommandAppointed": { "type": "boolean" },
        "requestedIsCommandAppointed": { "type": "boolean" }
      },
      "required": ["dutyId", "category", "jobTitle", "requestedLastName", "requestedRank", "requestedDateStarted", "requestor", "requestedScopeOfResponsibilities", "isNewHire", "isCsmApproved", "status", "createdAt"]
    },
    "VacancyDraft": {
      "title": "VacancyDraft",
      "description": "A user-submitted vacancy announcement draft.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "dutyId": { "type": "string" },
        "positionTitle": { "type": "string" },
        "shopName": { "type": "string" },
        "bpTitle": { "type": "string" },
        "tierLevel": { "type": "string" },
        "isSpecialty": { "type": "boolean" },
        "termDuration": { "type": "string" },
        "memoDate": { "type": "string" },
        "pocRankName": { "type": "string" },
        "pocEmail": { "type": "string" },
        "closeDeadlineDate": { "type": "string" },
        "signerNameCaps": { "type": "string" },
        "signerRank": { "type": "string" },
        "signerTitle": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "reviewed", "approved", "rejected", "filled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["dutyId", "positionTitle", "shopName", "status", "createdAt"]
    },
    "EmailTemplate": {
      "title": "EmailTemplate",
      "description": "An editable email template used for automated admin notifications.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subject": { "type": "string" },
        "body": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "subject", "body"]
    },
    "ShopRelationship": {
      "title": "ShopRelationship",
      "description": "Defines parent-child relationships between shops (categories).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "parentShop": { "type": "string" },
        "subShops": { "type": "array" }
      },
      "required": ["id", "parentShop", "subShops"]
    }
  },
  "firestore": {
    "/shop_relationships/{relationshipId}": {
      "schema": "ShopRelationship",
      "description": "Collection of parent-to-sub-shop relationships."
    },
    "/email_templates/{templateId}": {
      "schema": "EmailTemplate",
      "description": "Collection of default email templates for status changes."
    },
    "/duties/{dutyId}": {
      "schema": "Duty",
      "description": "Collection of all broadening and collateral duties."
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "List of authorized admins."
    },
    "/update_requests/{requestId}": {
      "schema": "UpdateRequest",
      "description": "Collection of visitor-submitted update requests."
    },
    "/vacancy_drafts/{draftId}": {
      "schema": "VacancyDraft",
      "description": "Collection of user-submitted vacancy announcement drafts."
    }
  }
}
