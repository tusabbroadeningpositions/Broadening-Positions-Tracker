rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---
    function isValidDuty(data) {
      return data.keys().hasAll(['category', 'jobTitle', 'lastName', 'rank', 'elementOrGroup', 'dutyType'])
        && data.category is string && data.category.size() <= 100
        && data.jobTitle is string && data.jobTitle.size() <= 200
        && data.lastName is string && data.lastName.size() <= 100
        && data.rank is string && data.rank.size() <= 50
        && data.elementOrGroup is string && data.elementOrGroup.size() <= 50
        && data.dutyType in ['EL', 'U', 'N/A']
        && (!('tierLevel' in data) || data.tierLevel == null || data.tierLevel is number)
        && (!('specialized' in data) || data.specialized is bool)
        && (!('isCommandAppointed' in data) || data.isCommandAppointed is bool)
        && (!('isNonTiered' in data) || data.isNonTiered is bool)
        && (!('dateStarted' in data) || data.dateStarted is string)
        && (!('termLength' in data) || data.termLength is string)
        && (!('termEndDate' in data) || data.termEndDate is string)
        && (!('updatedAt' in data) || data.updatedAt is string);
    }

    function isValidUpdateRequest(data) {
      return data.keys().hasAll(['dutyId', 'category', 'jobTitle', 'requestedLastName', 'requestedRank', 'requestedDateStarted', 'requestor', 'requestedScopeOfResponsibilities', 'isNewHire', 'isCsmApproved', 'status', 'createdAt'])
        && data.dutyId is string && data.dutyId.size() <= 128
        && data.category is string && data.category.size() <= 100
        && data.jobTitle is string && data.jobTitle.size() <= 200
        && data.requestedLastName is string && data.requestedLastName.size() <= 100
        && data.requestedRank is string && data.requestedRank.size() <= 50
        && data.requestedDateStarted is string && data.requestedDateStarted.size() <= 100
        && data.requestor is string && data.requestor.size() <= 150
        && data.requestedScopeOfResponsibilities is string && data.requestedScopeOfResponsibilities.size() <= 2000
        && data.isNewHire is bool
        && data.isCsmApproved is bool
        && data.status in ['pending', 'approved', 'rejected']
        && data.createdAt is string
        && (!('justification' in data) || data.justification is string)
        && (!('updatedAt' in data) || data.updatedAt is string)
        && (!('currentIsCommandAppointed' in data) || data.currentIsCommandAppointed is bool)
        && (!('requestedIsCommandAppointed' in data) || data.requestedIsCommandAppointed is bool)
        && (!('admin_secret' in data) || data.admin_secret is string);
    }

    function isValidEmailTemplate(data) {
      return data.keys().hasAll(['id', 'subject', 'body'])
        && data.id is string && data.id.size() <= 100
        && data.subject is string && data.subject.size() <= 500
        && data.body is string && data.body.size() <= 10000
        && (!('updatedAt' in data) || data.updatedAt is string)
        && (!('admin_secret' in data) || data.admin_secret is string);
    }

    function isValidShopRelationship(data) {
      return data.keys().hasAll(['id', 'parentShop', 'subShops'])
        && data.id is string && data.id.size() <= 150
        && data.parentShop is string && data.parentShop.size() <= 150
        && data.subShops is list
        && (!('admin_secret' in data) || data.admin_secret is string);
    }

    // --- Collections ---
    
    // Admins collection: only readable/writable by existing admins, 
    // but we'll allow initial setup for the user.
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Managed manually or via specific process
    }

    // Duties collection
    match /duties/{dutyId} {
      // Shared read access
      allow read: if true;
      
      // Admin-only write access via server secret
      allow create, update: if request.resource.data.admin_secret == "DUTY_TRACKER_SECRET_2024"
                           && isValidDuty(request.resource.data);
      allow delete: if true; 
    }

    // Shop Relationships collection
    match /shop_relationships/{relationshipId} {
      allow read: if true;
      allow create, update: if request.resource.data.admin_secret == "DUTY_TRACKER_SECRET_2024"
                           && isValidShopRelationship(request.resource.data);
      allow delete: if true;
    }

    // Update Requests collection
    match /update_requests/{requestId} {
      allow read, create: if true;
      allow update: if request.resource.data.admin_secret == "DUTY_TRACKER_SECRET_2024";
      allow delete: if true;
    }

    // Vacancy Drafts collection
    match /vacancy_drafts/{draftId} {
      allow read, create: if true;
      allow update, delete: if request.resource.data.admin_secret == "DUTY_TRACKER_SECRET_2024" || isAdmin();
    }

    // Email Templates collection
    match /email_templates/{templateId} {
      allow read: if true;
      allow create, update: if request.resource.data.admin_secret == "DUTY_TRACKER_SECRET_2024"
                            && isValidEmailTemplate(request.resource.data);
      allow delete: if request.resource.data.admin_secret == "DUTY_TRACKER_SECRET_2024";
    }
  }
}
